<?xml version="1.0" encoding="UTF-8"?>
<!--
DATABOSS x500 carrying an ARK Flow-equivalent sensor pair:
  - optical_flow (PX4 stock submodel, unmodified): PixArt PAW3902-faithful
    contract (max_flow_rate 7.4 rad/s, MODE_LOWLIGHT) per
    src/modules/simulation/gz_plugins/optical_flow/OpticalFlowSensor.cpp.
  - afbr_sensor_link (this model, new): Broadcom AFBR-S50LV85D-shaped
    downward ToF, modeled as an 8x4 gpu_lidar grid (32 samples) spanning the
    real 12.4x6.2 deg field of view. PX4's native distance_sensor path only
    reads ranges()[0] of a LaserScan (see GZBridge::laserScantoLidarSensorCallback),
    so this raw 32-sample grid is NOT consumed by GZBridge directly -- the
    4023_gz_x500_ark_flow airframe disables SIM_GZ_EN_LIDAR at boot, and
    scripts/sim/rangefinder_mavlink_bridge.py reads the full grid, applies
    the AFBR transmitter-beam pixel-selection model, and injects the
    resulting scalar via MAVLink DISTANCE_SENSOR instead.

Range accuracy/precision noise is NOT modeled at the SDF level (no <noise>
block below) -- that belongs in the Python bridge (databoss_sim.rangefinder),
same division of labor already used for the LK/SIFT optical-flow bridges.

Per Phase 15 scope decision, the IMU is intentionally left as x500_base's
shared default (modeled after IIM-42653, not ICM-42688-P) -- see
docs/phases/phase_15_ark_flow_module.md.
-->
<sdf version='1.9'>
  <model name='x500_ark_flow'>
    <self_collide>false</self_collide>
    <include merge='true'>
      <uri>x500</uri>
    </include>
    <include merge='true'>
      <uri>model://optical_flow</uri>
      <pose relative_to="base_link">0.03 0 -0.1 0 0 0</pose>
    </include>
    <include merge='true'>
      <uri>model://afbr_s50</uri>
      <pose relative_to="base_link">0 0 -0.079 0 1.57 0</pose>
    </include>
    <joint name="optical_flow_joint" type="fixed">
      <parent>base_link</parent>
      <child>flow_link</child>
      <pose relative_to="base_link">0 0 -0.1 0 1.5707 0</pose>
    </joint>
    <joint name="afbr_body_joint" type="fixed">
      <parent>base_link</parent>
      <child>afbr_s50_link</child>
      <pose relative_to="base_link">-0 0 0 0 0 0</pose>
    </joint>
    <joint name="afbr_sensor_joint" type="fixed">
      <parent>base_link</parent>
      <child>afbr_sensor_link</child>
    </joint>
    <link name="afbr_sensor_link">
      <pose relative_to="base_link">0 0 -0.05 0 1.57 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
      <sensor name='afbr_lidar' type='gpu_lidar'>
        <gz_frame_id>afbr_sensor_link</gz_frame_id>
        <pose>0 0 0 3.14 0 0</pose>
        <update_rate>50</update_rate>
        <ray>
          <scan>
            <!-- 8x4 = 32 samples approximating the AFBR-S50LV85D's real
                 32-pixel array across its real 12.4 x 6.2 deg FoV. Sample
                 count/rate are starting points (see phase doc), not
                 datasheet-exact geometry. -->
            <horizontal>
              <samples>8</samples>
              <resolution>1</resolution>
              <min_angle>-0.108210</min_angle>
              <max_angle>0.108210</max_angle>
            </horizontal>
            <vertical>
              <samples>4</samples>
              <resolution>1</resolution>
              <min_angle>-0.054105</min_angle>
              <max_angle>0.054105</max_angle>
            </vertical>
          </scan>
          <range>
            <!-- min is a PLACEHOLDER (not sourced from the AFBR datasheet --
                 not yet supplied). max=30.0 is the real datasheet figure. -->
            <min>0.02</min>
            <max>30.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>
  </model>
</sdf>
