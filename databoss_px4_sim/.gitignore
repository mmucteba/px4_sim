# Python virtual environments
venv/
venv_bridge/
__pycache__/
*.pyc

# Generated/derived experiment outputs (reproducible via the runner; not source)
experiments/runs/
experiments/batches/
experiments/comparisons/
experiments/inspections/
generated_worlds/

# Dashboard control-panel runtime state: one dir per launched job holding
# job.json, console.log and the generated launch.sh. This is process state,
# not evidence - the evidence lives in the run folder the job produces.
experiments/jobs/

# Dashboard smoke-test scenarios (Phase 17G terrain/wind validation). These
# are generated by POST /api/scenarios while exercising the builder, not
# curated experiment configs. Every archived run carries its own config.yaml
# copy, so the flights they produced stay reproducible without these.
experiments/configs/mvp/scenarios/test_*.yaml

# Large binary artifacts (safety net)
*.ulg
*.ulg.gz
