  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "title": "Schema Version",
      "type": "integer"
    },
    "generated_utc": {
      "title": "Generated Utc",
      "type": "string"
    },
    "runs": {
      "items": {
        "$ref": "#/$defs/IndexEntry"
      },
      "title": "Runs",
      "type": "array"
    },
    "comparisons": {
      "items": {
        "$ref": "#/$defs/ComparisonIndexEntry"
      },
      "title": "Comparisons",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "generated_utc",
    "runs",
    "comparisons"
  ],
  "title": "ExperimentsIndex",
  "type": "object"
}
