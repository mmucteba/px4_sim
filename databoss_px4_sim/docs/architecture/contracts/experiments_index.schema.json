{
  "$defs": {
    "ComparisonIndexEntry": {
      "additionalProperties": true,
      "properties": {
        "comparison_id": {
          "title": "Comparison Id",
          "type": "string"
        },
        "comparison_dir": {
          "title": "Comparison Dir",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "case_count": {
          "title": "Case Count",
          "type": "integer"
        },
        "run_ids": {
          "items": {
            "type": "string"
          },
          "title": "Run Ids",
          "type": "array"
        },
        "has_report_md": {
          "title": "Has Report Md",
          "type": "boolean"
        },
        "has_summary_csv": {
          "title": "Has Summary Csv",
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "comparison_id",
        "comparison_dir",
        "name",
        "title",
        "case_count",
        "run_ids",
        "has_report_md",
        "has_summary_csv",
        "warnings"
      ],
      "title": "ComparisonIndexEntry",
      "type": "object"
    },
    "IndexEntry": {
      "additionalProperties": true,
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "run_dir": {
          "title": "Run Dir",
          "type": "string"
        },
        "phase": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phase"
        },
        "scenario_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario Name"
        },
        "algorithm": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Algorithm"
        },
        "gnss_state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gnss State"
        },
        "world_variant": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "World Variant"
        },
        "tag_source": {
          "title": "Tag Source",
          "type": "string"
        },
        "contract_status": {
          "title": "Contract Status",
          "type": "string"
        },
        "accepted": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accepted"
        },
        "created_utc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created Utc"
        },
        "last_modified_utc": {
          "title": "Last Modified Utc",
          "type": "string"
        },
        "key_metrics": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Key Metrics",
          "type": "object"
        },
        "artifacts": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Artifacts",
          "type": "object"
        },
        "connections": {
          "$ref": "#/$defs/RunConnections"
        },
        "comparisons": {
          "items": {
            "type": "string"
          },
          "title": "Comparisons",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "run_dir",
        "tag_source",
        "contract_status",
        "last_modified_utc",
        "key_metrics",
        "artifacts",
        "connections",
        "comparisons",
        "warnings"
      ],
      "title": "IndexEntry",
      "type": "object"
    },
